# Copy to .env and load it into the shell before starting services.
# Do not commit real secrets. The JWT_SECRET fallback in code is for local-only
# development; always set a long, unique value outside an isolated local setup.

DATABASE_URL=postgresql://restaurant:restaurant_password@localhost:5432/restaurant_db?schema=public
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=

# Local infrastructure
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=restaurant-app
KAFKA_RETRY_ENABLED=true
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_INITIAL_DELAY_MS=500
KAFKA_RETRY_MAX_DELAY_MS=10000
KAFKA_DLQ_SUFFIX=.dlq

# Gateway/browser development. Use exact origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Logs and OpenTelemetry (the stack is defined in docker-compose.yml).
LOKI_URL=http://localhost:3100
LOKI_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set OTEL_SDK_DISABLED=true to disable instrumentation for a process.
# OTEL_SDK_DISABLED=false

# Optional service connection overrides; defaults are documented in docs/CONTEXT.md.
# AUTH_SERVICE_HOST=127.0.0.1
# AUTH_SERVICE_PORT=3001
# NOTIFICATION_SERVICE_HOST=127.0.0.1
# NOTIFICATION_SERVICE_PORT=3003
# RESTAURANT_SERVICE_URL=127.0.0.1:50051
# TABLE_SERVICE_URL=127.0.0.1:50052
# RESERVATION_SERVICE_URL=127.0.0.1:50053

# Do not set PORT globally when launching all services together: every process
# would inherit the same value. Set PORT per individual service if overriding it.
