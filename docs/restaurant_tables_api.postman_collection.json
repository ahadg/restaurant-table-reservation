    {
      "name": "8. Idempotency (replay demo)",
      "description": "Hit Send on this request TWICE. The first call executes and stores the response; the second call sends the identical Idempotency-Key and gets the stored response back without creating anything. Watch the response header Idempotency-Replayed and the Postman console.\n\nThe key here is deliberately FIXED (not {{$guid}}) so the replay is reproducible.",
      "item": [
        {
          "name": "Create Restaurant (fixed key - press Send twice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const replayed = pm.response.headers.get('Idempotency-Replayed');",
                  "console.log(replayed === 'true'",
                  "  ? 'REPLAYED -> served from the stored response; the handler did not run again.'",
                  "  : 'EXECUTED -> first run. Press Send again with the same Idempotency-Key to see the replay.');",
                  "pm.test('status is 201', () => pm.expect(pm.response.code).to.equal(201));",
                  "pm.test('Idempotency-Replayed header present', () => pm.expect(replayed).to.be.oneOf(['true', 'false']));",
                  "const body = pm.response.json();",
                  "if (body && body.id) { pm.collectionVariables.set('restaurantId', body.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "demo-fixed-key-0001",
                "type": "text",
                "description": "Fixed on purpose so a second Send replays instead of creating another restaurant."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Idempotency Demo Bistro\",\n  \"description\": \"Created once, replayed on retry\",\n  \"cuisine\": \"Test\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants"
              ]
            },
            "description": "Same key + same body = the second call returns the first response and creates nothing (verify with \"get restaurant list\" that only one \"Idempotency Demo Bistro\" exists).\n\nChange the body without changing the key and you get 422 instead - a key may not be reused for a different payload."
          },
          "response": []
        }
      ]
    }
