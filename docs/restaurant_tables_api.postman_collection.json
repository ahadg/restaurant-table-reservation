    {
      "name": "1. Auth",
      "item": [
        {
          "name": "/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "if (body && body.accessToken) {",
                  "    pm.collectionVariables.set('token', body.accessToken);",
                  "    console.log('Captured token from register');",
                  "}",
                  "if (body && body.user && body.user.id) {",
                  "    pm.collectionVariables.set('userId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Public. Validation: name (non-empty), email (valid), password (min 6 chars), role optional. Returns 409 if the email already exists. Auto-captures `accessToken` -> {{token}} and `user.id` -> {{userId}}.\n\nNOTE: re-running with the same email returns 409; that is expected, just use /auth/login instead."
          },
          "response": []
        },
        {
          "name": "auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "if (body && body.accessToken) {",
                  "    pm.collectionVariables.set('token', body.accessToken);",
                  "    console.log('Captured token from login');",
                  "}",
                  "if (body && body.user && body.user.id) {",
                  "    pm.collectionVariables.set('userId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
