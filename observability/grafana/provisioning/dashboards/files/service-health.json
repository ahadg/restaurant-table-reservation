{
  "uid": "service-health",
  "title": "Service Health Overview",
  "tags": ["restaurant", "services", "health", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": {
    "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" }]
  },
  "links": [
    { "title": "Prometheus Alerts", "url": "http://localhost:9090/alerts", "targetBlank": true, "type": "link" },
    { "title": "OpenTelemetry Signals Overview", "url": "http://localhost:3005/d/telemetry-overview/opentelemetry-signals-overview", "targetBlank": true, "type": "link" },
    { "title": "Kafka and DLQ Operations", "url": "http://localhost:3005/d/restaurant-operations/kafka-and-dlq-operations", "targetBlank": true, "type": "link" }
  ],
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Process CPU by service", "description": "CPU cores used by each Node.js process; 1.0 means one full CPU core. This is process-level, not Mac/host CPU.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(process_cpu_seconds_total[$__rate_interval]))", "legendFormat": "{{service_name}}" }], "fieldConfig": { "defaults": { "unit": "cores", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 2, "type": "timeseries", "title": "Process resident memory by service", "description": "Resident set size (RSS) for each application process.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "{{service_name}}" }], "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 3, "type": "timeseries", "title": "HTTP request rate by route", "description": "Route templates (e.g. /reservations/:id) keep the metric labels bounded; restart the API Gateway to begin collecting this custom route metric.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "refId": "A", "expr": "sum by (http_route, http_request_method) (rate(app_http_server_requests_total[$__rate_interval]))", "legendFormat": "{{http_request_method}} {{http_route}}" }], "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 4, "type": "timeseries", "title": "HTTP p95 latency by route", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route, http_request_method) (rate(app_http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{http_request_method}} {{http_route}}" }], "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 5, "type": "timeseries", "title": "HTTP 5xx responses by route", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }, "targets": [{ "refId": "A", "expr": "sum by (http_route) (rate(app_http_server_requests_total{http_response_status_code=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{http_route}}" }], "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 6, "type": "timeseries", "title": "Database operation p95 latency", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service_name, db_operation_name) (rate(db_client_operation_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{service_name}} / {{db_operation_name}}" }], "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 7, "type": "timeseries", "title": "Node.js event-loop p99 delay", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }, "targets": [{ "refId": "A", "expr": "nodejs_eventloop_delay_p99_seconds", "legendFormat": "{{service_name}}" }], "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 8, "type": "timeseries", "title": "Node.js event-loop utilization", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }, "targets": [{ "refId": "A", "expr": "nodejs_eventloop_utilization_ratio", "legendFormat": "{{service_name}}" }], "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 9, "type": "timeseries", "title": "Database client connections", "description": "OpenTelemetry database client pool observations; not the PostgreSQL server's total connection count.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }, "targets": [{ "refId": "A", "expr": "db_client_connection_count", "legendFormat": "{{service_name}} open" }, { "refId": "B", "expr": "db_client_connection_pending_requests", "legendFormat": "{{service_name}} pending" }], "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 10, "type": "timeseries", "title": "Process network throughput", "description": "Bytes received/transmitted by each app process; this is not total host network traffic.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 }, "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(process_network_receive_bytes_total[$__rate_interval]))", "legendFormat": "{{service_name}} received" }, { "refId": "B", "expr": "sum by (service_name) (rate(process_network_transmit_bytes_total[$__rate_interval]))", "legendFormat": "{{service_name}} sent" }], "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 11, "type": "timeseries", "title": "File descriptors used", "description": "Process open file descriptors divided by the process limit (where the platform exports these values).", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 }, "targets": [{ "refId": "A", "expr": "process_open_fds / process_max_fds", "legendFormat": "{{service_name}}" }], "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 12, "type": "logs", "title": "Application error logs (Loki)", "datasource": { "type": "loki", "uid": "loki" }, "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 }, "targets": [{ "refId": "A", "expr": "{service=~\".+\", level=\"error\"}", "queryType": "range", "direction": "backward", "maxLines": 100 }], "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none" } },
    { "id": 13, "type": "text", "title": "What these resource panels mean", "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "gridPos": { "h": 5, "w": 24, "x": 0, "y": 58 }, "options": { "mode": "markdown", "content": "**Best-practice note:** CPU, memory, network, and file-descriptor panels describe each instrumented Node.js process. They are not host/macOS or Docker-container totals. Avoid using raw URL paths, IDs, emails, or user IDs as metric labels; the route panels use bounded router templates. Host/container CPU, disk, and filesystem panels need a host-aware exporter; Docker Desktop on macOS reports its Linux VM rather than the Mac host." } }
  ]
}
