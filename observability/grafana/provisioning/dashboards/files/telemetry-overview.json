{
  "uid": "telemetry-overview",
  "title": "OpenTelemetry Signals Overview",
  "tags": ["opentelemetry", "telemetry", "metrics", "traces", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "annotations": {
    "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" }]
  },
  "links": [
    { "title": "Service Health Overview", "url": "http://localhost:3005/d/service-health/service-health-overview", "targetBlank": true, "type": "link" },
    { "title": "Kafka and DLQ Operations", "url": "http://localhost:3005/d/restaurant-operations/kafka-and-dlq-operations", "targetBlank": true, "type": "link" },
    { "title": "Prometheus Alerts", "url": "http://localhost:9090/alerts", "targetBlank": true, "type": "link" }
  ],
  "panels": [
    { "id": 14, "type": "timeseries", "title": "HTTP p95 latency by API route", "description": "Route-level latency from the API gateway interceptor. Routes are templates, so IDs and query strings do not create high-cardinality series.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route, http_request_method) (rate(app_http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{http_request_method}} {{http_route}}" }], "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 1, "type": "stat", "title": "OpenTelemetry collector scrape", "description": "Prometheus must scrape the collector's metrics endpoint successfully.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }, "targets": [{ "refId": "A", "expr": "up{job=\"otel-collector\"}", "legendFormat": "up (1 = healthy)" }], "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short", "min": 0, "max": 1 }, "overrides": [] }, "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" } },
    { "id": 2, "type": "stat", "title": "Services reporting process metrics", "description": "Counts services with recent process metrics; this indicates metric signal presence, not full application health.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }, "targets": [{ "refId": "A", "expr": "count(count by (service_name) (process_resident_memory_bytes)) or vector(0)", "legendFormat": "services" }], "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] }, "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" } },
    { "id": 3, "type": "stat", "title": "Services with HTTP telemetry", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }, "targets": [{ "refId": "A", "expr": "count(count by (service_name) (http_server_request_duration_seconds_count)) or vector(0)", "legendFormat": "HTTP services" }], "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] }, "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" } },
    { "id": 4, "type": "stat", "title": "Firing Prometheus alerts", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }, "targets": [{ "refId": "A", "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "firing" }], "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] }, "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" } },
    { "id": 5, "type": "table", "title": "Process uptime by service", "description": "If a service is missing, check its NODE_OPTIONS instrumentation bootstrap and OTLP endpoint.", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 }, "targets": [{ "refId": "A", "expr": "time() - process_start_time_seconds", "format": "table", "instant": true, "legendFormat": "{{service_name}}" }], "fieldConfig": { "defaults": { "unit": "s", "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } } },
    { "id": 6, "type": "timeseries", "title": "HTTP request rate by service", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 }, "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{service_name}}" }], "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 7, "type": "timeseries", "title": "HTTP p95 latency by service", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{service_name}} p95" }], "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 8, "type": "timeseries", "title": "Database operation rate", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 }, "targets": [{ "refId": "A", "expr": "sum by (service_name, db_operation_name) (rate(db_client_operation_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{service_name}} / {{db_operation_name}}" }], "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 9, "type": "timeseries", "title": "DLQ activity by service and source topic", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 }, "targets": [{ "refId": "A", "expr": "sum by (service_name, source_topic) (increase(kafka_dlq_published_total[$__rate_interval]))", "legendFormat": "{{service_name}} / {{source_topic}}" }], "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 10, "type": "timeseries", "title": "Application error logs by service", "datasource": { "type": "loki", "uid": "loki" }, "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 }, "targets": [{ "refId": "A", "expr": "sum by (service) (count_over_time({service=~\".+\", level=\"error\"}[$__interval]))", "queryType": "range", "legendFormat": "{{service}}" }], "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 11, "type": "traces", "title": "Recent distributed traces (Tempo)", "description": "Searches traces for the dashboard time range. Select a trace to inspect spans and jump to correlated Loki logs when trace IDs are present in log lines.", "datasource": { "type": "tempo", "uid": "tempo" }, "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 }, "targets": [{ "refId": "A", "queryType": "traceqlSearch", "query": "{}", "limit": 50 }] },
    { "id": 12, "type": "logs", "title": "Recent logs across services (Loki)", "datasource": { "type": "loki", "uid": "loki" }, "gridPos": { "h": 12, "w": 24, "x": 0, "y": 35 }, "targets": [{ "refId": "A", "expr": "{service=~\".+\"}", "queryType": "range", "direction": "backward", "maxLines": 200 }], "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none" } },
    { "id": 13, "type": "text", "title": "Signal coverage and limits", "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "gridPos": { "h": 5, "w": 24, "x": 0, "y": 47 }, "options": { "mode": "markdown", "content": "**Signals in this stack:** metrics flow from Node.js services through the OpenTelemetry Collector to Prometheus; traces flow through the collector to Tempo; application logs are sent directly to Loki. Empty trace panels mean there are no traces in the selected time window yet. The Tempo config currently retains traces for 24 hours and does not enable span-metrics/service-graph generation, so service maps and trace-derived RED metrics are not included. Process metrics are not host/container metrics." } }
  ]
}
